# ===========================================
# Backend 환경변수 설정
# ===========================================
# 이 파일을 .env로 복사 후 값을 수정하세요
# cp .env.example .env

# 디버그 모드 (true/false)
DEBUG=false

# 파일 저장 경로
UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results

# CORS 허용 도메인 (콤마로 구분)
# 프로덕션
ALLOWED_ORIGINS=https://goodboy.kakaolab.cloud,https://www.goodboy.kakaolab.cloud

# 로컬 개발용
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
