# ===========================================
# Senior-OCR-Project 환경변수 설정
# ===========================================
# 이 파일을 .env로 복사 후 값을 수정하세요
# cp .env.example .env

# ----- Backend 설정 -----
DEBUG=false
UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results

# CORS 허용 도메인 (콤마로 구분)
# 프로덕션: https://goodboy.kakaolab.cloud
# 로컬 개발: http://localhost:3000
ALLOWED_ORIGINS=https://goodboy.kakaolab.cloud,https://www.goodboy.kakaolab.cloud

# ----- Frontend 설정 -----
# Next.js 빌드 시 API URL
NEXT_PUBLIC_API_URL=https://goodboy.kakaolab.cloud/api

# ----- 도메인 설정 -----
DOMAIN=goodboy.kakaolab.cloud
